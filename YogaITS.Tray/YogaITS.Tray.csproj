<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>YogaITS.Tray</AssemblyName>
    <Product>YogaITS</Product>
    <Title>Yoga控制中心</Title>
    <Description>Yoga控制中心</Description>
    <VersionPrefix>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</VersionPrefix>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>YogaITS.Tray.Program</StartupObject>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest Condition="'$(EnableLiquidGlass)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(EnableLiquidGlass)' == 'true'">Build/liquid-glass.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/YogaITS.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YogaITS.Tray</RootNamespace>
  
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <Import Project="Build/Native.props" Condition="'$(EnableLiquidGlass)' != 'true'" />
  <Import Project="Build/LiquidGlass.props" Condition="'$(EnableLiquidGlass)' == 'true'" />
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Only the glass subtree is optional; shared controls and hardware services
       compile identically for both distributions. Test code is opt-in. -->
  <ItemGroup Condition="'$(EnableUiChecks)' == 'true'">
    <Compile Include="../Tests/YogaITS.UiChecks/UiContractChecks.cs" Link="Checks/UiContractChecks.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableLiquidGlass)' != 'true'">
    <Compile Remove="UI/Glass/**" />
    <Content Remove="CaptureIdentity/**" />
  </ItemGroup>

  <!--
    .NET 10 + unpackaged WinUI 3 publish currently generates the project PRI
    but may fail to add it to ResolvedFileToPublish. Without the app PRI,
    XAML resource lookup can fail at startup.
    Workaround matching microsoft/WindowsAppSDK#6720.
  -->
  <Target Name="AddProjectPriToResolvedFileToPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
