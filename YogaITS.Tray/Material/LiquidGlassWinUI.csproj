  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[2.2.0]" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="[1.3.2]" />
    <EmbeddedResource Include="Effects/Shaders/*.hlsl" />
  </ItemGroup>
</Project>
