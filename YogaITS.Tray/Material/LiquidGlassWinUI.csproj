    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>LiquidGlassWinUI</RootNamespace><AssemblyName>LiquidGlassWinUI</AssemblyName>
    <OutputType>Library</OutputType><UseWinUI>true</UseWinUI><WinUISDKReferences>false</WinUISDKReferences>
