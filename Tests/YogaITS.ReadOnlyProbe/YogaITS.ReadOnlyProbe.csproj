    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <Compile Include="../../YogaITS.Tray/Services/LenovoItsHelper.cs" Link="Services/LenovoItsHelper.cs" />
    <Compile Include="../../YogaITS.Tray/Services/LenovoMachineInfoHelper.cs" Link="Services/LenovoMachineInfoHelper.cs" />
    <Compile Include="../../YogaITS.Tray/Services/ItsCapabilityPolicy.cs" Link="Services/ItsCapabilityPolicy.cs" />
