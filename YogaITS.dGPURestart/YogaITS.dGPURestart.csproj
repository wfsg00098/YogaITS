    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../YogaITS.Tray/Services/AppBuild.cs" Link="AppBuild.cs" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Compile Include="../YogaITS.Tray/Services/AppLaunchPolicy.cs" Link="AppLaunchPolicy.cs" />
    <Compile Include="../YogaITS.Tray/Services/GpuActionResult.cs" Link="GpuActionResult.cs" />
    <Compile Include="../YogaITS.Tray/Services/GpuDeviceRestartProtocol.cs" Link="GpuDeviceRestartProtocol.cs" />
  </ItemGroup>
</Project>
